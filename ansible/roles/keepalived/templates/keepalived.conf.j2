# Managed by Ansible — do not edit manually
# Role: keepalived

vrrp_script chk_adguard {
    script "/usr/local/bin/check_adguard.sh"
    interval {{ keepalived_health_check_interval }}
    weight -20
    fall 2
    rise 2
}

vrrp_instance VI_ADGUARD {
    interface {{ keepalived_interface }}
    state {{ keepalived_state }}
    virtual_router_id {{ keepalived_router_id }}
    priority {{ keepalived_priority }}
    advert_int 1
    # Unicast, not multicast VRRP - simpler to reason about on this LAN and
    # avoids any chance of tripping the Unifi IDS/IPS's scanning-activity
    # detection (see Known Issue #94) the way real multicast/224.0.0.18
    # traffic conceivably could.
    unicast_src_ip {{ ansible_host }}
    unicast_peer {
{% for peer in keepalived_unicast_peers %}
        {{ peer }}
{% endfor %}
    }

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    virtual_ipaddress {
        {{ keepalived_vip }}/{{ keepalived_vip_cidr }}
    }

    track_script {
        chk_adguard
    }
}
