# Managed by Ansible — do not edit manually
# Role: alertmanager

route:
  receiver: discord
  group_by: ['alertname', 'instance']
  group_wait: {{ alertmanager_group_wait }}
  group_interval: {{ alertmanager_group_interval }}
  repeat_interval: {{ alertmanager_repeat_interval }}
{% if alertmanager_ha_webhook_url or alertmanager_ntfy_password %}
  routes:
    # Critical alerts that are still firing after the rule's own `for:`
    # plus this group_wait (~15m total) also push to the phones via HA.
    # Resolved-before-flush alerts (reboot flaps) never push. continue:
    # true + the catch-all below keeps Discord getting everything.
{% if alertmanager_ha_webhook_url %}
    - receiver: ha-push
      matchers: ['severity="critical"']
      group_wait: {{ alertmanager_ha_push_group_wait }}
      continue: true
{% endif %}
{% if alertmanager_ntfy_password %}
    - receiver: ntfy-push
      matchers: ['severity="critical"']
      group_wait: {{ alertmanager_ha_push_group_wait }}
      continue: true
{% endif %}
    - receiver: discord
{% endif %}

receivers:
  - name: discord
    discord_configs:
      - webhook_url: "{{ alertmanager_discord_webhook_url }}"
        username: "{{ alertmanager_discord_webhook_username }}"
        send_resolved: true
        title: '{{ '{{ .CommonLabels.alertname }} ({{ .Status | toUpper }})' }}'
        # summary, then the description (what to check) and when it started.
        message: |-
          {% raw %}{{ range .Alerts }}**{{ .Labels.instance }}**: {{ .Annotations.summary }}{{ if .Annotations.description }}
          {{ .Annotations.description }}{{ end }}
          Since {{ .StartsAt.Format "Jan 2 15:04 MST" }}
          {{ end }}{% endraw %}

{% if alertmanager_ha_webhook_url %}
  - name: ha-push
    webhook_configs:
      - url: "{{ alertmanager_ha_webhook_url }}"
        send_resolved: true
{% endif %}
{% if alertmanager_ntfy_password %}
  - name: ntfy-push
    webhook_configs:
      - url: "{{ alertmanager_ntfy_url }}"
        send_resolved: true
        http_config:
          basic_auth:
            username: "{{ alertmanager_ntfy_user }}"
            password: "{{ alertmanager_ntfy_password }}"
{% endif %}
